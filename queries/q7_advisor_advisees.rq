# Query 7: List academic advisors and their assigned advisee students
# Can be run on raw graph (using unigraph:advises) or inferred graph (using unigraph:supervises)
PREFIX unigraph: <https://unigraph.org/schema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?instructorName ?instructorRank ?studentName ?studentStatus
WHERE {
    ?instructor unigraph:advises ?student ;
                foaf:name ?instructorName .
    ?student foaf:name ?studentName .
    OPTIONAL { ?instructor unigraph:rank ?instructorRank }
    OPTIONAL { ?student unigraph:status ?studentStatus }
}
ORDER BY ?instructorName ?studentName
