unigraph:involvedInCourse a rdf:Property,
        rdfs:Resource ;
    rdfs:label "involvedInCourse"@en ;
    rdfs:comment "Generic involvement of a person in a course or section."@en ;
    rdfs:domain unigraph:Person ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf unigraph:involvedInCourse .

unigraph:supervises a rdf:Property,
        rdfs:Resource ;
    rdfs:label "supervises"@en ;
    rdfs:comment "Supervisory relationship between an academic staff member and a student."@en ;
    rdfs:domain unigraph:Instructor ;
    rdfs:range unigraph:Student ;
    rdfs:subPropertyOf unigraph:associatedWith,
        unigraph:supervises .

