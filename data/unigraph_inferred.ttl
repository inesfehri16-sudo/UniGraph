@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unigraph: <https://unigraph.org/schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

unigraph:Building a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Building"@en ;
    rdfs:comment "A campus building containing rooms."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Building .

unigraph:Course a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Course"@en ;
    rdfs:comment "An academic course offered by a department."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Course .

unigraph:CourseSection a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "CourseSection"@en ;
    rdfs:comment "A specific offering or section of a course during a semester."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:CourseSection .

unigraph:Department a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Department"@en ;
    rdfs:comment "An academic department within the university, specialization of foaf:Organization."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Organization,
        unigraph:Department .

unigraph:Enrollment a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Enrollment"@en ;
    rdfs:comment "A student's enrollment record in a course section including grade."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Enrollment .

unigraph:Instructor a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Instructor"@en ;
    rdfs:comment "A member of the academic teaching staff."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Person,
        unigraph:Instructor,
        unigraph:Person .

unigraph:Lecturer a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Lecturer"@en ;
    rdfs:comment "A teaching instructor with lecturer rank."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Person,
        unigraph:Instructor,
        unigraph:Lecturer,
        unigraph:Person .

unigraph:Person a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human being within the university system, specialization of foaf:Person."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Person,
        unigraph:Person .

unigraph:Professor a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Professor"@en ;
    rdfs:comment "A tenured or tenure-track professor rank (assistant, associate, full)."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Person,
        unigraph:Instructor,
        unigraph:Person,
        unigraph:Professor .

unigraph:Program a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Program"@en ;
    rdfs:comment "A degree-granting academic curriculum/program."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Program .

unigraph:Room a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Room"@en ;
    rdfs:comment "A physical room where sections are held or offices are located."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Room .

unigraph:Semester a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Semester"@en ;
    rdfs:comment "An academic period (e.g. Fall 2021, Spring 2022)."@en ;
    rdfs:subClassOf rdfs:Resource,
        unigraph:Semester .

unigraph:Student a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Student"@en ;
    rdfs:comment "An enrolled student in an academic program."@en ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Person,
        unigraph:Person,
        unigraph:Student .

